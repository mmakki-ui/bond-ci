#!/bin/sh
# /usr/sbin/bondctl — P5 thin CLI. Kept user surface, but de-daemonized:
# it only PARSES intent and WRITES desired facts (mode / auto), then invokes
# the stateless executor (bond-xctl) which walks the DAG. All operational
# logic (engage/verify/revert/genconf/aggregate) lives in bond-xctl; all mode
# policy lives in bond-ecod. bondctl writes NO endpoints and starts NO
# feeders directly — that is the whole point of the P5 split (ADR-001).
#
#   bondctl on|off|status
#   bondctl mode lightning|eco|<aggregate modes>   (eco IS the auto policy; others pin)
#       the aggregate mode names are NOT listed here or anywhere else in this
#       file -- they come from `bond-xctl _sched_modes` (the AGG_SCHED_TABLE).
#   bondctl auto on|off                       (ecod mode policy)
#   bondctl shape on|off                      (E4 shaping fact; converged by the DAG)
#   bondctl _mode_auto lightning|eco          (internal: ecod only)
#
# BUSYBOX-SAFE POSIX sh.

BOND_DIR="${BOND_DIR:-/etc/bond}"
RUN_DIR="${RUN_DIR:-/var/run/bond}"
XCTL="${XCTL:-/usr/sbin/bond-xctl}"
ECOD_SVC="${ECOD_SVC:-/etc/init.d/bond-ecod}"
WDOG_SVC="${WDOG_SVC:-/etc/init.d/bond-watchdog}"
# SVC is the eco/lightning FEEDER service, still engarde today (U50b owns the
# mechanism). U50a deleted this file's `ENGARDE_BIN` outright: after `need()`
# below stopped reading it, nothing in the CLI referenced the binary at all, and
# a declared-but-unread path is exactly the kind of stale hook that grows a new
# dependency later.
SVC="${SVC:-/etc/init.d/engarde-client}"
ECOD_BIN="${ECOD_BIN:-/usr/sbin/bond-ecod}"
WG_DEV="${WG_DEV:-wgclient1}"
# U66/SC2034: `LOCAL_EP="127.0.0.1:59401"` was here and was DEAD -- bondctl writes no
# endpoints (see the header: it parses intent and writes facts, nothing else), and the
# live value is bond-xctl's derived `127.0.0.1:${ENGARDE_PORT}`. A dead second copy of a
# port number is a hardcode waiting to disagree with the one that is actually applied,
# so it is deleted rather than annotated.
TAG="bondctl"
log() { echo "$TAG: $*"; logger -t "$TAG" "$*" 2>/dev/null; }
# need(): the CLI's "is P5 installed" precondition. Same MEANING as bond-xctl
# guard_installed() -- "P5 is here and can write its facts" -- but not the same
# text any more: each side names the artifact it actually needs (see below).
#
# It used to be `[ -x "$ENGARDE_BIN" ]`, which gated EVERY verb (on/off/mode/
# _mode_auto/auto) on P2's binary. That is the same dependency the ROADMAP's U50
# entry describes on the DAG guard, one layer up in the CLI, and it was NOT named
# there -- found by U50a's own Layer-2 bar, which could not walk a single edge with
# the binary removed until this changed. Dropping only the DAG term would have left
# the removal unobservable from the CLI, i.e. unmeasurable.
#
# This does NOT remove engarde from the box: the client still carries
# /usr/sbin/engarde-client and the tunnel still runs through it on :59401
# (docs/knowledge/inventory/2026-08-30-client-flint2.txt). It removes P5's
# dependency on it.
#
# SECOND ROUND. `[ -d "$BOND_DIR" ]` was still not a P5 fact: nothing in
# deploy/p5 created that directory, and the repo's only creator of it is
# p2-engarde/bootstrap-bond.sh -- so on a box where E7 removed the old stack the
# CLI refused every verb for the same reason it used to, one dependency along.
# `need()` now tests a P5 artifact and creates a P5 directory:
#   * $XCTL is the executor this CLI exists to drive. It is shipped by P5 and by
#     nothing else, every verb below invokes it, and a box without it genuinely
#     does not have P5 installed -- which is what this function claims to check.
#   * $BOND_DIR is where the next two lines of every verb write `mode` / `auto`,
#     so bondctl makes it, exactly as bond-xctl mkfacts() does. bondctl does not
#     take bond-xctl's lock, so it cannot rely on that call.
# mkdir failure is still fatal: a box that cannot hold the facts must not be told
# its mode was set.
need() {
    [ -x "$XCTL" ] || { echo "$TAG: $XCTL missing — P5 not installed" >&2; exit 1; }
    [ -d "$BOND_DIR" ] || mkdir -p "$BOND_DIR" 2>/dev/null
    [ -d "$BOND_DIR" ] || { echo "$TAG: cannot create $BOND_DIR — P5 has nowhere to write its facts" >&2; exit 1; }
}

set_auto_on() {            # ADR-003: `eco` IS the auto policy -- selecting it ENABLES the policy
    [ -x "$ECOD_BIN" ] || { echo "$TAG: bond-ecod not installed" >&2; exit 1; }
    touch "$BOND_DIR/auto"
    "$ECOD_SVC" enable 2>/dev/null; "$ECOD_SVC" restart 2>/dev/null || { echo "$TAG: bond-ecod start failed" >&2; exit 1; }
    "$WDOG_SVC" enable 2>/dev/null; "$WDOG_SVC" start 2>/dev/null
    log "auto policy ON"
}

# mode_usage: the accepted mode set, DERIVED. Non-aggregate modes are this
# CLI's own (lightning|eco); the aggregate ones are whatever the ONE table in
# bond-xctl holds, asked for at print time. If bond-xctl cannot answer (older
# binary, not installed) the aggregate half is simply absent -- this CLI never
# claims a mode it cannot confirm.
mode_usage() {
    _amu=$("$XCTL" _sched_modes 2>/dev/null)
    echo "usage: bondctl mode lightning|eco${_amu:+|$_amu}" >&2
}

clear_auto_if_manual() {   # manual intent wins: drop auto + stop ecod
    if [ -f "$BOND_DIR/auto" ]; then
        rm -f "$BOND_DIR/auto"; "$ECOD_SVC" stop 2>/dev/null
        log "auto policy disabled by manual mode change"
    fi
}

case "${1:-}" in
  on)   need; "$SVC" enable  2>/dev/null; "$XCTL" reconcile ;;   # write rc fact -> reconcile
  off)  need; "$SVC" disable 2>/dev/null; "$XCTL" reconcile ;;   # clear rc fact -> reconcile (disengage)
  mode)
    M="${2:-}"
    # ACCEPTANCE is derived, not listed. `lightning|eco` are this CLI's own
    # modes; anything else is accepted iff the AGG_SCHED_TABLE claims it. So a
    # third aggregate scheduler is ONE row in bond-xctl and ZERO edits here --
    # the property Layer-2 AGG-L12 executes. Pre-fix this branch spelled the
    # mode list out, and `bondctl mode <new>` was refused by the parser after
    # the table row was added.
    case "$M" in
      lightning|eco) : ;;
      # EMPTY is refused HERE, not delegated: `_sched ""` answers for the STORED
      # mode (a query default kept for bond-ecod), so without this arm
      # `bondctl mode` with the argument forgotten was ACCEPTED on an aggregating
      # box (stored max|speed -> _sched exit 0), wrote an EMPTY mode fact, and
      # the follow-up reconcile tore the aggregate down -- while the same typo
      # on a lightning box was refused. Acceptance must not depend on box state.
      # Layer-2 AGG-L14 executes exactly this.
      "") mode_usage; exit 1 ;;
      *) "$XCTL" _sched "$M" >/dev/null 2>&1 || { mode_usage; exit 1; } ;;
    esac
    need
    # ADR-003 fact model: INTENT and STATE are read from the PAIR (auto, mode).
    #   auto set   -> intent is ECO (adaptive); mode is ecod CURRENT POSITION (eco|lightning)
    #   auto unset -> mode is the user manual pin
    # So `mode eco` ENABLES the policy; it must NOT clear it. Every other mode pins.
    if [ "$M" = eco ]; then set_auto_on; else clear_auto_if_manual; fi
    PREV=$(cat "$BOND_DIR/mode" 2>/dev/null)
    echo "$M" > "$BOND_DIR/mode"
    # AGGREGATE MODES (max|speed) can FAIL their verify, so the CLI restores the
    # prior mode; every other mode is a live config switch that cannot. The class
    # test is `bond-xctl _sched`, NOT a comparison against a mode name: the mode ->
    # scheduler table has ONE owner (bond-xctl AGG_SCHED_TABLE) and adding a third
    # aggregate mode must not require editing this branch. Pre-U17 this read
    # `[ "$M" = speed ]`, which is exactly the per-mode dispatch that would have
    # had to be duplicated for `max`.
    if "$XCTL" _sched "$M" >/dev/null 2>&1; then
        if "$XCTL" reconcile; then :; else                    # desired=engaged_agg -> agg
            echo "${PREV:-lightning}" > "$BOND_DIR/mode"      # CLI restores prior mode on failure
            echo "$TAG: FATAL: $M engage failed; mode restored to ${PREV:-lightning}" >&2; exit 1
        fi
    else
        "$XCTL" reconcile refresh                             # live config switch (tunnel intact)
        log "mode -> $M"
    fi
    ;;
  shape)
    # E4 (U22): write the DESIRED shaping fact, then reconcile. This is the
    # fact-writer contract and nothing else: bondctl must NEVER call the shaper
    # directly (that is what made shaping a second controller -- ADR-001
    # decision 1, superseded by docs/knowledge/design/e4-shaping-in-dag.md).
    # `reconcile refresh` because a shaping change is a CONFIG change: the
    # tunnel is intact, so it rides the `switch` edge, whose action list ends in
    # shape_apply. Shaping never gates the tunnel (INV8), so this never fails
    # the lifecycle.
    case "${2:-}" in on|off) : ;;
      *) echo "usage: bondctl shape on|off" >&2; exit 1 ;; esac
    need
    echo "$2" > "$BOND_DIR/shape"
    "$XCTL" reconcile refresh
    log "shape -> $2"
    ;;
  _mode_auto)
    # internal: bond-ecod only. Keeps auto set. Never selects an aggregate mode.
    M="${2:-}"
    case "$M" in lightning|eco) : ;; *) echo "auto policy never selects '$M'" >&2; exit 1 ;; esac
    need
    echo "$M" > "$BOND_DIR/mode"
    "$XCTL" reconcile refresh
    ;;
  auto)
    need
    case "${2:-}" in
      on)
        set_auto_on
        ;;
      off)
        rm -f "$BOND_DIR/auto"
        "$ECOD_SVC" stop 2>/dev/null; "$ECOD_SVC" disable 2>/dev/null
        log "auto policy OFF (mode stays: $(cat "$BOND_DIR/mode" 2>/dev/null))"
        ;;
      *) echo "usage: bondctl auto on|off" >&2; exit 1 ;;
    esac
    ;;
  status)
    N=$("$XCTL" node 2>/dev/null)
    EP=$(wg show "$WG_DEV" endpoints 2>/dev/null | awk '{print $2}' | head -1)
    echo "bond:     node=$N  mode=$(cat "$BOND_DIR/mode" 2>/dev/null || echo -)  auto=$( [ -f "$BOND_DIR/auto" ] && echo on || echo off )"
    echo "shape:    want=$(cat "$BOND_DIR/shape" 2>/dev/null || echo on)  observed=$("$XCTL" _shape 2>/dev/null || echo unknown)"
    echo "endpoint: ${EP:-unknown}   (127.0.0.1:59401=bonded 59402=aggregate; else=direct)"
    [ -r "$RUN_DIR/tput" ] && echo "tput:     $(cat "$RUN_DIR/tput" 2>/dev/null)"
    # LOW: avoid `grep -oE` (busybox `-o` portability). Probe each feeder name once.
    _feeders=""
    for _s in engarde-client bond-agg; do
        ubus call service list 2>/dev/null | grep -q "\"$_s\"" && _feeders="$_feeders$_s "
    done
    echo "feeders:  $_feeders"
    ;;
  _primary)  "$XCTL" _primary ;;
  _server)   "$XCTL" _server ;;   # read-only: bond server in-tunnel HOST (no port)
  # _sched: read-only passthrough of the AGG_SCHED_TABLE (bond-xctl owns it).
  # Prints the aggregate scheduler for $2 (default: the stored mode), exit 3 when
  # the mode is not an aggregate mode. bond-ecod uses it to skip aggregate modes
  # without carrying a second copy of the mode class -- and relies on the exit
  # code being 3 rather than 1 to tell that answer apart from an old CLI that
  # does not know the verb, so the passthrough must not collapse it.
  _sched)      "$XCTL" _sched "${2:-}" ;;
  # _sched_modes: read-only passthrough of the aggregate mode NAMES.
  _sched_modes) "$XCTL" _sched_modes ;;
  selfcheck) "$XCTL" selfcheck ;;
  *) echo "usage: bondctl on|off|status|mode <mode>|auto on|off|shape on|off" >&2; mode_usage; exit 1 ;;
esac

#!/bin/sh /etc/rc.common
# procd service: bond-ecod (auto mode policy). START order 95: after the
# feeders (94), before the watchdog (96) which observes everyone.
#
# U66/SC2034: START, STOP and USE_PROCD are the /etc/rc.common INTERFACE -- the
# shebang hands this file to rc.common, which sources it and reads them. They are
# unused *within this file* by design, so the exclusion is per-variable below and
# not a file-wide or severity-wide cut.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/p5-ecod
    procd_set_param respawn 3600 5 5      # crash-liveness: procd owns respawn
    procd_set_param stderr 1
    procd_close_instance
}

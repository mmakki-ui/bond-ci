#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# P5-OWNED-INIT: deploy/p5/init.d/cake-autorate
# ^ THE OWNERSHIP MARKER, and it is load-bearing, not decoration. `/etc/init.d/
# cake-autorate` is a name P1 already uses on the client (its own cake-autorate
# service, S97cake-autorate in rc.d, running production traffic). shape-install
# REFUSES to install over a file without this line, and REFUSES to remove one,
# so P5 can neither clobber nor delete a controller it did not write. Do not
# change the string without changing shape-install's P5_MARK.
#
# procd service: cake-autorate — P5's shaping CONTROLLER. U22a (E4 install half).
#
# This is what bond-xctl's `SHAPE_SVC=` default names. Placed by `shape-install`, enabled and
# restarted ONLY by the DAG's act_shape_apply, so shaping has exactly one
# controller. It is a P5-owned wrapper around the VENDORED, SHA-PINNED
# cake-autorate at $BASE/current — it is not upstream's own init script and it
# never fetches anything.
#
# WHY A WRAPPER AND NOT UPSTREAM'S SCRIPT: upstream cake-autorate expects
# something else (sqm-scripts, on the deployed P1 box) to have created the
# INGRESS mirror it shapes download on. P5 does not install sqm-scripts and must
# not write GL's /etc/config/sqm (shape-install §SQM). So the mirror belongs to
# whoever owns the shaper's lifecycle, which is this script: created on start,
# torn down on stop, so `SHAPE_SVC running` covers both halves of the shaper and
# bond-xctl's shape_now() stays a truthful single probe.
#
# NO SHAPING CONSTANT IS SET HERE. Rates, reflectors and tuning live in
# $BASE/config.p5.sh, generated by shape-install from declared facts. The
# numbers that DO appear in this file are supervision plumbing, each with its
# provenance beside it (procd's documented respawn defaults, the START/STOP
# ordering above, and a tc filter priority that is an identifier, not a tuned
# value) -- none is a shaping parameter and none was picked by measurement
# because none shapes anything.
#
# INV8: nothing in this file can affect the tunnel. It attaches an ingress
# qdisc + an ifb mirror to the WireGuard interface and runs a userspace
# controller. It touches no route, no firewall rule, no WireGuard config, and
# no management path, so a failure here cannot cost the box.
#
# START 97: after the feeders (94) and the watchdog (96). Shaping is the last
# thing to come up and the first to go down; it gates nothing.
#
# NEVER EXECUTED ON EITHER BOX (no procd here). Layer-2 substitutes svc-shape.
START=97
STOP=05
USE_PROCD=1

BOND_DIR="${BOND_DIR:-/etc/bond}"
BASE="${SHAPE_BASE:-/usr/lib/p5/cake-autorate}"
TC="${TC:-tc}"
IP="${IP:-ip}"

# the SAME two-step discovery bond-xctl shape_if() and shape-install use.
shape_if() {
    _I=$(cat "$BOND_DIR/wg_if" 2>/dev/null)
    [ -n "$_I" ] || _I="${WG_DEV:-}"
    echo "$_I"
}

# live_dir — resolve $BASE/current, which shape-install writes as a POINTER FILE
# holding the version directory's NAME (not a symlink: `mv` over a plain file is
# rename(2) and therefore an atomic switch, with no symlink for `mv` to
# dereference and no dependency on the filesystem supporting links). Prints
# nothing when there is no valid payload, so every caller fails closed.
live_dir() {
    _c=$(cat "$BASE/current" 2>/dev/null)
    case "$_c" in
        v-[0-9a-f]*) : ;;             # only a name this installer could have written
        *) return 1 ;;
    esac
    case "$_c" in */*|*..*) return 1 ;; esac
    [ -d "$BASE/$_c" ] || return 1
    echo "$BASE/$_c"
}

# mirror_up IF — idempotent. Creates ifb4<IF> and redirects <IF>'s ingress onto
# it, which is what makes cake-autorate's dl_if real. Every step tolerates
# already-done, because recovery here is "run it again".
mirror_up() {
    _if="$1"; _ifb="ifb4$_if"
    [ -n "$_if" ] || return 1
    $IP link show "$_ifb" >/dev/null 2>&1 || $IP link add name "$_ifb" type ifb >/dev/null 2>&1
    $IP link set dev "$_ifb" up >/dev/null 2>&1
    $TC qdisc add dev "$_if" handle ffff: ingress >/dev/null 2>&1
    # NOTE: `replace` on a filter is not portable across busybox tc builds, so
    # the redirect is added only when absent rather than blindly replaced.
    # `prio 10` is an IDENTIFIER (tc requires a priority to address a filter),
    # not a tuned value: this is the only filter ever placed on ffff:, so any
    # priority behaves identically. sqm-scripts uses the same convention.
    $TC filter show dev "$_if" parent ffff: 2>/dev/null | grep -q "$_ifb" || \
        $TC filter add dev "$_if" parent ffff: protocol all prio 10 u32 \
            match u32 0 0 flowid 1:1 action mirred egress redirect dev "$_ifb" >/dev/null 2>&1
    return 0
}

mirror_down() {
    _if="$1"; _ifb="ifb4$_if"
    [ -n "$_if" ] || return 0
    $TC qdisc del dev "$_if" ingress >/dev/null 2>&1
    $TC qdisc del dev "$_ifb" root   >/dev/null 2>&1
    $IP link set dev "$_ifb" down    >/dev/null 2>&1
    $IP link del "$_ifb"             >/dev/null 2>&1
    return 0
}

start_service() {
    _if=$(shape_if)
    if [ -z "$_if" ]; then
        logger -t cake-autorate "no tunnel interface discovered (BOND_DIR/wg_if); not starting"
        return 1
    fi
    _live=$(live_dir) || {
        logger -t cake-autorate "no live payload: $BASE/current is absent or does not name a staged version; run shape-install"
        return 1
    }
    [ -x "$_live/cake-autorate.sh" ] || {
        logger -t cake-autorate "vendored payload missing at $_live; run shape-install"
        return 1
    }
    [ -r "$BASE/config.p5.sh" ] || {
        logger -t cake-autorate "generated config missing at $BASE/config.p5.sh; run shape-install"
        return 1
    }
    mirror_up "$_if"
    procd_open_instance
    procd_set_param command "$_live/cake-autorate.sh" "$BASE/config.p5.sh"
    # crash-liveness: procd owns respawn. The triple IS procd's documented
    # default (threshold 3600s, timeout 5s, 5 retries), restated so the policy
    # is visible in the file rather than implied by an omitted parameter --
    # NOT a value this unit measured or tuned.
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    mirror_down "$(shape_if)"
}

#!/bin/sh /etc/rc.common
# procd service: bond-watchdog. START order 96 — LAST, so it observes all the
# feeders + ecod. procd owns crash-liveness (respawn); the watchdog itself
# carries ZERO respawn duty for others — its only restart action is
# `init.d X start` for the enabled-but-absent (respawn-exhausted) case.
#
# U66/SC2034: START, STOP and USE_PROCD are the /etc/rc.common INTERFACE -- the
# shebang hands this file to rc.common, which sources it and reads them. They are
# unused *within this file* by design, so the exclusion is per-variable below and
# not a file-wide or severity-wide cut.
# shellcheck disable=SC2034
START=96
# shellcheck disable=SC2034
STOP=09
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/p5-watchdog
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

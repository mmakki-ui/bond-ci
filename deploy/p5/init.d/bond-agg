#!/bin/sh /etc/rc.common
# procd service: bond-agg (the AGGREGATE feeder). START order 94 — first feeder.
# Installed/enabled only while the mode is an AGGREGATE mode (max|speed --
# U126 DELETED bond-xctl act_agg_install, so nothing writes this file at runtime;
# the shipped canonical copy). AGG_SCHED (max|speed) selects the scheduler and
# is the whole of the difference between the two modes at this layer. procd
# instance-watchdog covers hang-liveness for our OWN daemon (it can poke ubus).
#
# U66/SC2034: START, STOP and USE_PROCD are the /etc/rc.common INTERFACE -- the
# shebang hands this file to rc.common, which sources it and reads them. They are
# unused *within this file* by design, so the exclusion is per-variable below and
# not a file-wide or severity-wide cut. Same in init.d/bond-ecod and
# init.d/bond-watchdog. Everything from START=94 down MUST stay byte-identical to
# the package installer, which places it from the filemap and manifest-checks it
# (run.sh AGG-L9-a asserts the reconciler has no runtime writer).
# shellcheck disable=SC2034
START=94
# shellcheck disable=SC2034
STOP=11
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
    [ -r /etc/p5/agg_env ] || return 1
    # U66/SC1091: agg_env is GENERATED at runtime by `bond-xctl act_env_gen`; it is
    # not in the repo, so there is no file for `shellcheck -x` to follow. Left
    # unfollowed on purpose -- pointing it at /dev/null would instead make every
    # AGG_* below read as unassigned.
    # shellcheck disable=SC1091
    . /etc/p5/agg_env
    procd_open_instance
    procd_set_param command /usr/sbin/p5-datapath
    # U225/M2: AGG_STATS is a LITERAL here and deliberately NOT sourced from
    # agg_env. agg_env is generated by `bond-xctl act_env_gen` and compared
    # against agg_env.applied to decide whether the feeder must bounce; adding a
    # key there would make every already-installed box see a changed env on
    # upgrade and restart a working datapath for a read-only stats file. The path
    # is inside the declared runtime namespace (/var/run/p5/*, contract/paths).
    #
    # U253/U252 (2026-09-07): the seven AGG_PULL_* keys. procd hands the daemon EXACTLY this
    # env and nothing else, so a key that build_agg_env writes into agg_env and this line does
    # not name never reaches /usr/sbin/p5-datapath. That was the state U253 shipped: cap_env
    # and tx_backoff_env emitted all seven and this line passed none, so the cap's enable path
    # stopped one hop short of the mechanism it enables. It read green because the model's
    # MF-ENV-1 comparison could not run at all -- its emitter parser hard-errored on the new
    # emission form before the two key sets were ever compared.
    # ABSENT FACT = EMPTY STRING, which is the correct fail-safe and NOT a new default: `. `
    # above leaves an unemitted key unset, "$KEY" expands empty, and cap.go requires
    # AGG_PULL_CAP to be exactly "on" (CapConfigFromEnv) while pullrun.go:314 ignores an empty
    # AGG_PULL_TXBACKOFF_US. Empty is the shipped OFF state for all seven.
    # ONE PHYSICAL LINE: bond_model.py's stanza parser reads a single `procd_set_param env`
    # line and counts a continuation's tokens as NOT passed through. Length is the cost.
    procd_set_param env AGG_MODE=pull-client AGG_LISTEN="$AGG_LISTEN" AGG_SERVER="$AGG_SERVER" AGG_PATHS="$AGG_PATHS" AGG_W="$AGG_W" AGG_SCHED="$AGG_SCHED" AGG_SPOTTY="$AGG_SPOTTY" AGG_LIGHTNING="$AGG_LIGHTNING" AGG_PULL_CAP="$AGG_PULL_CAP" AGG_PULL_CAP_TARGET_MS="$AGG_PULL_CAP_TARGET_MS" AGG_PULL_CAP_TRIP="$AGG_PULL_CAP_TRIP" AGG_PULL_CAP_CLEAR="$AGG_PULL_CAP_CLEAR" AGG_PULL_CAP_MINRATE_KBPS="$AGG_PULL_CAP_MINRATE_KBPS" AGG_PULL_CAP_DET_MS="$AGG_PULL_CAP_DET_MS" AGG_PULL_TXBACKOFF_US="$AGG_PULL_TXBACKOFF_US" AGG_STATS=/var/run/p5/datapath.stats
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

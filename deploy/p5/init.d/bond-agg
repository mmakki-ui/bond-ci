#!/bin/sh /etc/rc.common
# procd service: bond-agg (EIF speed feeder). START order 94 — first feeder.
# Installed/enabled only while mode=speed (bond-xctl act_agg_install writes an
# identical stanza on demand; this file is the shipped canonical copy). procd
# instance-watchdog covers hang-liveness for our OWN daemon (it can poke ubus).
START=94
STOP=11
USE_PROCD=1
start_service() {
    [ -r /etc/bond/agg_env ] || return 1
    . /etc/bond/agg_env
    procd_open_instance
    procd_set_param command /usr/sbin/bond-agg
    procd_set_param env AGG_MODE=client AGG_LISTEN=$AGG_LISTEN AGG_SERVER=$AGG_SERVER AGG_PATHS=$AGG_PATHS AGG_W=$AGG_W AGG_SPOTTY=$AGG_SPOTTY AGG_LIGHTNING=$AGG_LIGHTNING
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

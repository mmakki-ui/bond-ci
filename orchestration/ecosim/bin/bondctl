#!/bin/sh
D="$STUBDIR"
case "$1" in
  _server)
    # stub: bond server in-tunnel HOST ONLY (no :port) so ecod TPROBE can ping it.
    echo "10.0.0.1"
    ;;
  _primary)
    n=$(cat "$D/tick" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$D/tick"
    L=$(sed -n "${n}p" "$D/plan"); [ -n "$L" ] || L=$(tail -1 "$D/plan")
    # U66/SC2086: DELIBERATE. $L is one whitespace-separated row of $D/plan and the
    # split into $1..$5 is the whole point; quoting makes it a single positional and
    # the health fields below all collapse to their defaults.
    # shellcheck disable=SC2086
    set -- $L
    echo "$1" > "$D/cur_primary"; echo "$2 ${3:-20} ${4:-OK} ${5:-141}" > "$D/cur_health"
    echo "$1"
    ;;
  _mode_auto)
    echo "$2" >> "$D/calls"
    echo "$2" > "$BOND_DIR/mode"
    if [ "$2" = "eco" ]; then cp "$D/cur_primary" "$BOND_DIR/applied_wans"
    else printf 'eth1 usb0' > "$BOND_DIR/applied_wans"; fi
    ;;
esac

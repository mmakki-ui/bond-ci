#!/bin/sh
# fake wg: reads/writes $ECOSIM_STATE/{ep,rx,tx,hs}. One fake peer pubkey.
S="$ECOSIM_STATE"; PUB="PEERPUBKEY000000000000000000000000000000000="
case "$1 $2" in
  "show "*)
    case "$3" in
      peers)             echo "$PUB" ;;
      endpoints)         echo "$PUB $(cat "$S/ep" 2>/dev/null)" ;;
      transfer)          echo "$PUB $(cat "$S/rx" 2>/dev/null || echo 0) $(cat "$S/tx" 2>/dev/null || echo 0)" ;;
      latest-handshakes) echo "$PUB $(cat "$S/hs" 2>/dev/null || echo 0)" ;;
      *) : ;;
    esac ;;
  "set "*)
    # wg set DEV peer PUB endpoint EP
    shift 2; while [ $# -gt 0 ]; do [ "$1" = endpoint ] && { echo "$2" > "$S/ep"; break; }; shift; done ;;
  *) : ;;
esac
exit 0

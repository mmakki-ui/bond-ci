#!/bin/sh
# fake /etc/init.d/engarde-client
S="$ECOSIM_STATE"; N=engarde-client
case "$1" in
  enable)  echo 1 > "$S/enabled.$N" ;;
  disable) echo 0 > "$S/enabled.$N" ;;
  start)   echo 1 > "$S/running.$N"; echo "SVC $N start" >> "$S/ledger" ;;
  # restart COUNTS: a restart bounces the datapath. The old shim hid these (it treated
  # restart == start), which is what let the BLOCKER-1 restart-storm pass unseen. F16
  # asserts a healthy-box watchdog tick causes ZERO restarts.
  restart) c=$(cat "$S/restarts.$N" 2>/dev/null || echo 0); echo $((c+1)) > "$S/restarts.$N"; echo 1 > "$S/running.$N"; echo "SVC $N restart" >> "$S/ledger" ;;
  stop)    echo 0 > "$S/running.$N" ;;
  enabled) [ "$(cat "$S/enabled.$N" 2>/dev/null)" = 1 ] || exit 1 ;;
esac
exit 0
